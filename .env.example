# ---- Mercury environment ----------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# Every integration has a fixture mode. With nothing below set, the whole demo
# runs offline.

# Rail mode: "fixture" (offline, deterministic, default) or "live" (real Stripe test keys)
RAIL_MODE=fixture

# Stripe TEST MODE ONLY. Required when RAIL_MODE=live.
# Dashboard -> Developers -> API keys (test mode). StripeRail refuses a live key.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
# The webhook signing secret is read in both rail modes: set it and
# /api/webhook/stripe verifies real Stripe deliveries even while
# RAIL_MODE=fixture. Unset, fixture mode falls back to its own demo secret and
# live mode answers 503. Dashboard -> Developers -> Webhooks -> Signing secret.
STRIPE_WEBHOOK_SECRET=

# Mail: "fixture" (in-memory inbox, the "send a test email" button; default) or "gmail".
# For gmail: the agent's own Gmail address and an app password (Google Account ->
# Security -> 2-Step Verification -> App passwords). IMAP must be enabled on the account.
MAIL_MODE=fixture
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_POLL_SECONDS=15

# Chat: "fixture" (in-memory channel; default) or "slack".
# For slack: one incoming-webhook URL (api.slack.com/apps -> Incoming Webhooks).
CHAT_MODE=fixture
SLACK_WEBHOOK_URL=

# Calendar: "fixture" (in-memory; default) or "google".
# For google: a service-account JSON (inline, or a path to the file) and the id of a
# calendar shared with the service account's email with "Make changes to events".
CALENDAR_MODE=fixture
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Purchase log: "fixture" (in-memory; default) or "google". Same service account as the
# calendar; the spreadsheet is shared with it as an editor. The tab defaults to "Purchases".
SHEETS_MODE=fixture
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Purchases

# Anthropic API key. Only for the Claude negotiator; the scripted agent needs no key.
ANTHROPIC_API_KEY=

# Model configuration
MERCURY_MODEL=claude-opus-5
MERCURY_EFFORT=high

# Database
MERCURY_DB=./mercury.db
